# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 의해 절대 커밋되지 않습니다. 실제 값을 여기(.env.example)에 넣지 마세요.

# ⚠️ ANTHROPIC_API_KEY 는 설정하지 마세요.
#    봇은 Claude Code(`claude -p`)를 '구독 인증'으로 호출해 Claude 구독(Max 등) 한도에서
#    차감합니다. ANTHROPIC_API_KEY 가 있으면 구독보다 API 키를 우선해 별도 종량 과금되므로
#    두지 않습니다(claude_runner.py 가 자식 프로세스에서도 강제 제외).

# Claude Code 구독 토큰 — 로컬에서 `claude setup-token` 으로 1년짜리 발급 후 붙여넣기.
# (호스트에 이미 `claude` 로그인이 돼 있으면 비워둬도 됨 — 디스크 로그인 사용)
CLAUDE_CODE_OAUTH_TOKEN=

# 텔레그램 봇 토큰 — @BotFather 의 /newbot 으로 발급
TELEGRAM_BOT_TOKEN=

# 텔레그램 소유자 chat id — 화이트리스트(이 id 외 발신자는 무응답)
TELEGRAM_CHAT_ID=

# (선택) 노션 로그 동기화 — 둘 다 있어야 동작, 없으면 로컬 SQLite 만 기록
# NOTION_TOKEN=
# NOTION_DB_ID=

# (선택) SQLite 경로 덮어쓰기 — 기본 data/watchlist.db
# WATCHLIST_DB=data/watchlist.db

# (선택) claude 실행 파일 경로 — PATH 에 없을 때만
# CLAUDE_BIN=claude
