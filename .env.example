# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 의해 절대 커밋되지 않습니다. 실제 키를 여기(.env.example)에 넣지 마세요.

# Anthropic API 키 — digest.py 에서 사용 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 텔레그램 봇 토큰 — @BotFather 의 /newbot 으로 발급
TELEGRAM_BOT_TOKEN=

# 텔레그램 chat id — getUpdates 응답의 chat.id 값
TELEGRAM_CHAT_ID=

# (선택) Discord 로 발송할 때만 필요 — notify.send_discord 사용 시
# DISCORD_WEBHOOK_URL=
