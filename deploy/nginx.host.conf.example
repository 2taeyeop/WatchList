# EC2 '호스트' nginx 서버블록 예시 — 서브도메인 → web 컨테이너(127.0.0.1:8080).
# 기존 다른 서비스(React/Spring)와 같은 nginx 에 server 블록 하나 추가하는 방식.
# TLS 는 certbot(Let's Encrypt) 사용 가정. 실제 도메인/경로로 바꿔 쓰세요.

server {
    listen 80;
    server_name watch.example.com;          # ← 본인 서브도메인
    # certbot 설치 후 80→443 리다이렉트 + 인증서 라인은 certbot 이 자동 추가.

    location / {
        proxy_pass http://127.0.0.1:8080;     # web 컨테이너(compose ports 8080:80)
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 세팅 순서:
#   1) DNS: watch.example.com  A 레코드 → EC2 퍼블릭 IP
#   2) 이 파일을 /etc/nginx/sites-available/watch 로 복사 후 sites-enabled 심볼릭링크
#   3) sudo nginx -t && sudo systemctl reload nginx
#   4) sudo certbot --nginx -d watch.example.com   (HTTPS 자동 설정)
