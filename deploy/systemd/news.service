[Unit]
Description=WatchList 뉴스 반등 후보 (Claude Code 구독 + Telegram + DB 저장)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# digest 와 동일하게 Claude Code(Node)를 구독 인증으로 호출하므로 '호스트에서' 실행.
# 사전 준비는 digest 와 동일(README 섹션 7): venv + Claude Code + .env 의 토큰.
WorkingDirectory=/opt/watchlist
EnvironmentFile=/opt/watchlist/.env       # CLAUDE_CODE_OAUTH_TOKEN / TELEGRAM_* (ANTHROPIC_API_KEY 없을 것)
# Environment=CLAUDE_BIN=/usr/local/bin/claude
ExecStart=/opt/watchlist/.venv/bin/python -m backend.jobs.news_scan
